<UserControl x:Class="VnManager.PlaynitePlugin.Installation.InstallationConfigurationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource TextBrush}"
             MinWidth="620">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,16" Text="{Binding Purpose}" TextWrapping="Wrap" />

        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,4,12,12" VerticalAlignment="Center" Text="Pasta do jogo" />
        <TextBox x:Name="GameDirectoryTextBox" Grid.Row="1" Grid.Column="1" Margin="0,0,8,12"
                 CaretBrush="{DynamicResource TextBrush}" Foreground="{DynamicResource TextBrush}"
                 Text="{Binding GameDirectory, UpdateSourceTrigger=PropertyChanged}" />
        <Button Grid.Row="1" Grid.Column="2" Margin="0,0,0,12" Padding="12,3" Content="Procurar..." Click="BrowseGameDirectoryClick" />

        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,4,12,12" VerticalAlignment="Center" Text="Executável" />
        <TextBox x:Name="ExecutablePathTextBox" Grid.Row="2" Grid.Column="1" Margin="0,0,8,12"
                 CaretBrush="{DynamicResource TextBrush}" Foreground="{DynamicResource TextBrush}"
                 Text="{Binding ExecutablePath, UpdateSourceTrigger=PropertyChanged}" />
        <Button Grid.Row="2" Grid.Column="2" Margin="0,0,0,12" Padding="12,3" Content="Procurar..." Click="BrowseExecutableClick" />

        <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,4,12,12" VerticalAlignment="Center" Text="Arquivos extras" />
        <TextBox x:Name="ExtraFilesDirectoryTextBox" Grid.Row="3" Grid.Column="1" Margin="0,0,8,12"
                 CaretBrush="{DynamicResource TextBrush}" Foreground="{DynamicResource TextBrush}"
                 Text="{Binding ExtraFilesDirectory, UpdateSourceTrigger=PropertyChanged}" />
        <Button Grid.Row="3" Grid.Column="2" Margin="0,0,0,12" Padding="12,3" Content="Procurar..." Click="BrowseExtraFilesDirectoryClick" />

        <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Foreground="{DynamicResource WarningBrush}"
                   VerticalAlignment="Center" Text="{Binding ValidationError}" TextWrapping="Wrap" />
        <StackPanel Grid.Row="4" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Margin="0,0,8,0" Padding="16,4" Content="Concluir" Click="CompleteClick" />
            <Button Padding="16,4" Content="Cancelar" Click="CancelClick" />
        </StackPanel>
    </Grid>
</UserControl>
