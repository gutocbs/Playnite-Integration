<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Abstractions\Abstractions.csproj" />
    <ProjectReference Include="..\Host\Host.csproj" />
    <ProjectReference Include="..\LocaleEmulator\LocaleEmulator.csproj" />
    <ProjectReference Include="..\NoRegionLoader\NoRegionLoader.csproj" />
    <ProjectReference Include="..\Logging\Logging.csproj" />
    <ProjectReference Include="..\ProcessManagement\ProcessManagement.csproj" />
    <ProjectReference Include="..\TestAssets\LocaleEmulatorStub\LocaleEmulatorStub.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\TestAssets\PersistentA\PersistentA.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\TestAssets\PersistentB\PersistentB.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\TestAssets\ShortLived\ShortLived.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Adapter\Logging.psm1"
          Link="TestAssets\Adapter\Logging.psm1"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Adapter\PlayniteAdapter.ps1"
          Link="TestAssets\Adapter\PlayniteAdapter.ps1"
          CopyToOutputDirectory="PreserveNewest" />
    <None Update="PlayniteAdapterHarness.ps1"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CopyTestExecutables" AfterTargets="Build">
    <ItemGroup>
      <LocaleEmulatorStubFiles Include="..\TestAssets\LocaleEmulatorStub\bin\$(Configuration)\net10.0\*" />
      <PersistentAFiles Include="..\TestAssets\PersistentA\bin\$(Configuration)\net10.0\*" />
      <PersistentBFiles Include="..\TestAssets\PersistentB\bin\$(Configuration)\net10.0\*" />
      <ShortLivedFiles Include="..\TestAssets\ShortLived\bin\$(Configuration)\net10.0\*" />
      <HostFiles Include="..\Host\bin\$(Configuration)\net10.0\*" />
    </ItemGroup>
    <Copy SourceFiles="@(LocaleEmulatorStubFiles)" DestinationFolder="$(OutDir)TestAssets\LocaleEmulatorStub" />
    <Copy SourceFiles="@(PersistentAFiles)" DestinationFolder="$(OutDir)TestAssets\PersistentA" />
    <Copy SourceFiles="@(PersistentBFiles)" DestinationFolder="$(OutDir)TestAssets\PersistentB" />
    <Copy SourceFiles="@(ShortLivedFiles)" DestinationFolder="$(OutDir)TestAssets\ShortLived" />
    <Copy SourceFiles="@(HostFiles)" DestinationFolder="$(OutDir)TestAssets\Host" />
  </Target>

</Project>
